{
  "name": "proofback-site-tools",
  "private": true,
  "description": "Checks for the static website in ../site. Not published.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "html-validate ../site/index.html ../site/404.html ../site/app/index.html",
    "smoke": "node site-smoke.mjs",
    "check": "npm run validate && npm run smoke",
    "app": "node app-smoke.mjs"
  },
  "devDependencies": {
    "html-validate": "11.19.0",
    "playwright": "1.65.1"
  }
}
